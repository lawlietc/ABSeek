{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["electron/main/core/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*", "electron/**/*", "shared/**/*", "cli/**/*"],
  "exclude": ["node_modules", "prototype", "out"]
}
